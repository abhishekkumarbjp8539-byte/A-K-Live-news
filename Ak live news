<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>A K LIVE NEWS | ताज़ा खबरें</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Arial, sans-serif;
    background:#f2f2f2;
    color:#222;
}

/* TOP HEADER */
.top{
    background:#d40000;
    color:white;
    padding:8px 15px;
    text-align:center;
    font-size:14px;
}

/* LOGO */
header{
    background:white;
    padding:15px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    box-shadow:0 2px 5px #aaa;
}

.logo{
    font-size:25px;
    font-weight:bold;
    color:#d40000;
}

.logo span{
    color:#111;
}

/* MENU */
nav{
    background:#111;
    overflow-x:auto;
    white-space:nowrap;
}

nav a{
    display:inline-block;
    color:white;
    text-decoration:none;
    padding:13px 15px;
    font-size:14px;
}

nav a:hover{
    background:#d40000;
}

/* BREAKING */
.breaking{
    background:#fff;
    margin:12px;
    display:flex;
    align-items:center;
    overflow:hidden;
}

.breaking-title{
    background:#d40000;
    color:white;
    padding:12px;
    font-weight:bold;
}

.breaking-text{
    padding:10px;
    white-space:nowrap;
    animation:move 15s linear infinite;
}

@keyframes move{
    from{transform:translateX(100%);}
    to{transform:translateX(-100%);}
}

/* CONTAINER */
.container{
    max-width:1100px;
    margin:auto;
    padding:10px;
}

/* HERO NEWS */
.hero{
    background:white;
    margin-bottom:15px;
    border-radius:6px;
    overflow:hidden;
    box-shadow:0 1px 5px #bbb;
}

.hero img{
    width:100%;
    height:250px;
    object-fit:cover;
}

.hero-content{
    padding:15px;
}

.hero h1{
    font-size:24px;
    margin-bottom:10px;
}

.read{
    display:inline-block;
    background:#d40000;
    color:white;
    padding:10px 15px;
    text-decoration:none;
    border-radius:4px;
    margin-top:10px;
}

/* SECTION TITLE */
.section-title{
    background:#111;
    color:white;
    padding:12px;
    border-left:5px solid #d40000;
    margin:20px 0 12px;
}

/* NEWS GRID */
.news-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:15px;
}

.card{
    background:white;
    border-radius:6px;
    overflow:hidden;
    box-shadow:0 1px 5px #ccc;
}

.card img{
    width:100%;
    height:160px;
    object-fit:cover;
}

.card-content{
    padding:12px;
}

.card h3{
    font-size:18px;
    margin-bottom:8px;
}

.card p{
    color:#555;
    font-size:14px;
}

/* SUBMIT NEWS */
.submit{
    background:white;
    padding:20px;
    margin-top:20px;
    border-radius:6px;
    box-shadow:0 1px 5px #ccc;
}

.submit input,
.submit textarea,
.submit select{
    width:100%;
    padding:12px;
    margin:7px 0 12px;
    border:1px solid #ccc;
    border-radius:4px;
}

.submit textarea{
    height:120px;
}

.submit button{
    width:100%;
    background:#d40000;
    color:white;
    border:0;
    padding:13px;
    border-radius:4px;
    font-size:16px;
}

/* FOOTER */
footer{
    background:#111;
    color:white;
    text-align:center;
    margin-top:30px;
    padding:25px 15px;
}

footer h2{
    color:#ff3333;
    margin-bottom:10px;
}

footer p{
    color:#ccc;
    font-size:14px;
    margin:6px;
}

/* MOBILE */
@media(max-width:700px){

    header{
        padding:12px;
    }

    .logo{
        font-size:21px;
    }

    .news-grid{
        grid-template-columns:1fr;
    }

    .hero img{
        height:210px;
    }

    .hero h1{
        font-size:20px;
    }

    .card img{
        height:200px;
    }
}
</style>
</head>

<body>

